<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The app itself, its pages, components and scripts, shared by its hosts: the browser (Melodex.Web.Browser) and the
       phone app (Melodex.App). Its files are served from the root, as they were when this was the browser app. -->
  <PropertyGroup>
    <RootNamespace>Melodex.Web</RootNamespace>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <!-- The user guide, shown under Settings → Help, and the changelog. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\guide\*.md" LogicalName="help/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="help/CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Melodex.Client\Melodex.Client.csproj" />
  </ItemGroup>

</Project>
