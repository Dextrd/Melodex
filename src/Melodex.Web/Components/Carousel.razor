@using Microsoft.JSInterop
@inject IJSRuntime Js

@*
    One row of tiles that scrolls sideways, the full width of the page (carousel.js). On a computer, a round arrow floats
    over each end while there's more that way, and that end fades out; on a touch screen it's swiped.
*@
<div class="carousel @Class" @ref="_box">
    <IconButton Icon="back" Class="small carousel-back" Title="Back" />
    <div class="carousel-track">@ChildContent</div>
    <IconButton Icon="forward" Class="small carousel-on" Title="More" />
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }

    private ElementReference _box;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await Js.InvokeVoidAsync("melodexCarousel.update", _box);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
