@implements IDisposable
@inject MelodexClient Api
@inject NavigationManager Nav
@inject ServerEvents Events

@*
    Your ListenBrainz and Last.fm accounts (#2), on Your account: linked, every song you play is sent there too. ListenBrainz
    takes the user token from its settings; Last.fm sends you there to allow Melodex, and back to the Last.fm page here.
*@
@if (_status is null)
{
    <Loading Inline="true" />
}
else
{
    <div class="scrobble-links">
        <div class="scrobble-link">
            <div>
                <strong>ListenBrainz</strong>
                @if (Link(ScrobbleService.ListenBrainz) is { } brainz)
                {
                    @Linked(brainz)
                }
                else
                {
                    <div class="muted small">
                        Free and open, run by the MetaBrainz Foundation. Copy your user token from
                        <a href="https://listenbrainz.org/settings/" target="_blank" rel="noopener">your ListenBrainz settings</a>.
                    </div>
                    <div class="row">
                        <input type="password" autocomplete="off" placeholder="User token" aria-label="ListenBrainz user token" @bind="_token" @bind:event="oninput" />
                        <button type="button" class="primary" disabled="@(_busy || _token.Trim().Length == 0)" @onclick="LinkListenBrainzAsync">Link</button>
                    </div>
                }
            </div>
        </div>
        <div class="scrobble-link">
            <div>
                <strong>Last.fm</strong>
                @if (Link(ScrobbleService.LastFm) is { } lastFm)
                {
                    @Linked(lastFm)
                }
                else if (_status.LastFmApiKey is { } key)
                {
                    <div class="muted small">Last.fm asks you to allow Melodex, then sends you back here.</div>
                    <div class="row"><a class="btn primary" href="@LastFmHref(key)">Link Last.fm</a></div>
                }
                else
                {
                    <div class="muted small">The admin hasn't set a Last.fm API key yet, which linking needs: it's in Settings → Playback.</div>
                }
            </div>
        </div>
    </div>
    @if (_error is not null) { <div class="error small" role="alert">@_error</div> }
}

@code {
    private ScrobbleStatus? _status;
    private string _token = "";
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Events.Received += OnEvent;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _status = await Api.GetScrobblingAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
            _status ??= new ScrobbleStatus([], null);
        }
    }

    private ScrobbleLink? Link(ScrobbleService service) => _status?.Links.FirstOrDefault(l => l.Service == service);

    // Last.fm sends you back to the page that finishes linking, with its token.
    private string LastFmHref(string key) =>
        $"https://www.last.fm/api/auth/?api_key={Uri.EscapeDataString(key)}&cb={Uri.EscapeDataString(Nav.ToAbsoluteUri("account/lastfm").ToString())}";

    private RenderFragment Linked(ScrobbleLink link) => @<text>
        <div class="muted small">
            Linked as <strong>@link.Username</strong>.
            @if (link.LastSentAt is { } sent) { <span>Last sent @Format.Ago(sent).</span> }
            @if (link.Waiting > 0) { <span>@Format.Count(link.Waiting, "play waits", "plays wait") to be sent.</span> }
        </div>
        @if (link.Error is { } error) { <div class="error small">@error</div> }
        <div class="row"><button type="button" disabled="@_busy" @onclick="() => UnlinkAsync(link.Service)">Unlink</button></div>
    </text>;

    private async Task LinkListenBrainzAsync()
    {
        await RunAsync(async () =>
        {
            await Api.LinkListenBrainzAsync(_token);
            _token = "";
        });
    }

    private Task UnlinkAsync(ScrobbleService service) => RunAsync(() => Api.UnlinkScrobblingAsync(service));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }

    private void OnEvent(string type)
    {
        if (type is "plays")
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
    }

    public void Dispose() => Events.Received -= OnEvent;
}
