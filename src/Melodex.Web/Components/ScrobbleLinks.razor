@implements IDisposable
@inject MelodexClient Api
@inject NavigationManager Nav
@inject ServerEvents Events

@*
    Your accounts on the scrobbling services the admin set up (#2, #236), on Your account: linked, every song you play is
    sent there too. Some take a token you paste, such as ListenBrainz's; others, such as Last.fm, send you to allow
    Melodex and back to a page here that finishes linking.
*@
@if (_services is null)
{
    <Loading Inline="true" />
}
else if (_services.Count == 0)
{
    <p class="muted small">There's nowhere to send plays yet: the admin adds scrobbling services, such as ListenBrainz and Last.fm, in Settings → Plugins.</p>
}
else
{
    <div class="scrobble-links">
        @foreach (var service in _services)
        {
            <div class="scrobble-link" @key="service.Id">
                <strong>@service.Name</strong>
                @if (service.Linked is { } link)
                {
                    <div class="muted small">
                        Linked as <strong>@link.Username</strong>.
                        @if (link.LastSentAt is { } sent) { <span>Last sent @Format.Ago(sent).</span> }
                        @if (link.Waiting > 0) { <span>@Format.Count(link.Waiting, "play waits", "plays wait") to be sent.</span> }
                    </div>
                    @if (link.Error is { } error) { <div class="error small">@error</div> }
                    <div class="row"><button type="button" disabled="@_busy" @onclick="() => UnlinkAsync(service)">Unlink</button></div>
                }
                else if (service.Link == ScrobbleLinkKind.Web)
                {
                    <div class="muted small">@service.Name asks you to allow Melodex, then sends you back here.</div>
                    <div class="row"><button type="button" class="primary" disabled="@_busy" @onclick="() => GoLinkAsync(service)">Link @service.Name</button></div>
                }
                else
                {
                    <div class="muted small">
                        Paste the token from your
                        @if (service.Homepage is { } home)
                        {
                            <a href="@home" target="_blank" rel="noopener">@service.Name</a>
                        }
                        else
                        {
                            @service.Name
                        }
                        account's settings.
                    </div>
                    <div class="row">
                        <input type="password" autocomplete="off" placeholder="Token" aria-label="@($"{service.Name} token")"
                               value="@Token(service)" @oninput="e => SetToken(service, e)" />
                        <button type="button" class="primary" disabled="@(_busy || Token(service).Trim().Length == 0)" @onclick="() => LinkAsync(service)">Link</button>
                    </div>
                }
            </div>
        }
    </div>
}
@if (_error is not null) { <div class="error small" role="alert">@_error</div> }

@code {
    private IReadOnlyList<ScrobbleService>? _services;
    private readonly Dictionary<Guid, string> _tokens = [];
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Events.Received += OnEvent;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _services = await Api.GetScrobblingAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
            _services ??= [];
        }
    }

    private string Token(ScrobbleService service) => _tokens.GetValueOrDefault(service.Id, "");

    private void SetToken(ScrobbleService service, ChangeEventArgs e) => _tokens[service.Id] = e.Value?.ToString() ?? "";

    private Task LinkAsync(ScrobbleService service) => RunAsync(async () =>
    {
        await Api.LinkScrobblingAsync(service.Id, Token(service));
        _tokens.Remove(service.Id);
    });

    // The service sends you back to the page that finishes linking, with its token.
    private Task GoLinkAsync(ScrobbleService service) => RunAsync(async () =>
    {
        var url = await Api.GetScrobbleLinkPageAsync(service.Id, Nav.ToAbsoluteUri($"account/scrobbling/{service.Id}").ToString());
        Nav.NavigateTo(url, forceLoad: true);
    });

    private Task UnlinkAsync(ScrobbleService service) => RunAsync(() => Api.UnlinkScrobblingAsync(service.Id));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }

    private void OnEvent(string type)
    {
        if (type is "plays")
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
    }

    public void Dispose() => Events.Received -= OnEvent;
}
