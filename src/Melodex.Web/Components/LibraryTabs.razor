@inject NavSections Sections
@inject AuthState Auth

@* The Library page's tabs: what's made for you from what you play, browsing what you have, your playlists, songs
   fetched to listen to now, songs and albums you'd like, and what you've played. *@
<nav class="page-tabs" aria-label="Library">
    @if (Auth.May(UserPermissions.Listen))
    {
        <a href="" class="@(Current == "for-you" ? "active" : null)" aria-current="@(Current == "for-you" ? "page" : null)">For you</a>
    }
    <a href="@Sections.BrowseHref" class="@(Current == "browse" ? "active" : null)" aria-current="@(Current == "browse" ? "page" : null)">Browse</a>
    @if (Auth.May(UserPermissions.Listen))
    {
        <a href="playlists" class="@(Current == "playlists" ? "active" : null)" aria-current="@(Current == "playlists" ? "page" : null)">Playlists</a>
        <a href="listen-now" class="@(Current == "listen-now" ? "active" : null)" aria-current="@(Current == "listen-now" ? "page" : null)">Listen now</a>
        <a href="wishlist" class="@(Current == "wishlist" ? "active" : null)" aria-current="@(Current == "wishlist" ? "page" : null)">Wishlist</a>
        <a href="history" class="@(Current == "history" ? "active" : null)" aria-current="@(Current == "history" ? "page" : null)">History</a>
    }
</nav>

@code {
    /// <summary><c>for-you</c>, <c>browse</c>, <c>playlists</c>, <c>listen-now</c>, <c>wishlist</c> or <c>history</c>.</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "browse";
}
