@inject MelodexClient Api
@inject Preferences Prefs

@*
    Albums like this one (#226), on an album's page, in one row that scrolls sideways: those songs like its songs come
    from, and albums by artists like its artist. The section is shut until opened, and stays as it was left; they're
    asked for with the page either way, so it opens on them. It shows from the start, saying it's asking; nothing shows
    when no discovery plugin finds songs or artists, and when none led to any album, the section says so.
*@
@if (_offered || _checked is null)
{
    <h2 class="section"><SectionToggle Open="_open" OnToggle="ToggleAsync">Similar albums</SectionToggle></h2>
    <Collapsible Open="_open">
        @if (_similar is null)
        {
            <TileSlots Text="Asking the discovery plugins…" />
        }
        else if (_similar.Count > 0)
        {
            <Carousel Class="similar-albums">
                @foreach (var similar in _similar)
                {
                    var album = similar.Album;
                    <a class="tile arrives" href="@Format.AlbumHref(album)" title="@Title(similar)">
                        <Cover Url="@album.CoverUrl" />
                        <div class="tile-name">@album.Title</div>
                        <div class="muted small tile-sub">@album.ArtistCredit@(Format.Year(album.FirstReleaseDate) is { Length: > 0 } year ? $" · {year}" : "")</div>
                        @if (album.Status is AlbumStatus.Complete or AlbumStatus.Partial) { <div><span class="badge owned">In library</span></div> }
                    </a>
                }
            </Carousel>
        }
        else if (_error is null)
        {
            <div class="muted small">No similar albums found: the discovery plugins don't know this one's songs or artist well enough yet.</div>
        }
        @if (_error is not null) { <div class="muted small" role="status">Couldn't find similar albums: @_error</div> }
    </Collapsible>
}

@code {
    [Parameter, EditorRequired] public Guid AlbumId { get; set; }

    /// <summary>How many to show.</summary>
    [Parameter] public int Take { get; set; } = 12;

    private const string OpenKey = "similarAlbumsOpen";

    private IReadOnlyList<SimilarAlbum>? _similar;
    private Guid _loaded;
    private bool _offered, _open;
    private bool? _checked;
    private string? _error;

    private Task ToggleAsync()
    {
        _open = !_open;
        return Prefs.SetAsync(OpenKey, _open);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AlbumId == _loaded)
            return;
        (_loaded, _similar, _error) = (AlbumId, null, null);
        try
        {
            if (_checked is null)
            {
                _open = await Prefs.GetAsync(OpenKey, false);
                var status = await Api.GetDiscoveryAsync();
                _offered = status.SimilarSongs || status.SimilarArtists;
                _checked = true;
            }
            if (!_offered)
                return;
            // Drawn as it's asked for, saying so, not only once the albums come.
            StateHasChanged();
            var similar = await Api.ListSimilarAlbumsAsync(AlbumId, Take);
            if (AlbumId == _loaded)
                _similar = similar;
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            (_offered, _similar, _error) = (true, [], e.Message);
        }
    }

    private static string Title(SimilarAlbum similar) =>
        $"{similar.Album.Title} · {similar.Album.ArtistCredit} · {Math.Round(similar.Score * 100)}% alike, through {string.Join(" and ", similar.From)}";
}
