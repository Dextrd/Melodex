@* A list of albums with their status. *@
@inject Player Player

<div class="card">
    <table class="table albums">
        <thead>
            <tr>
                <th class="cover-col"></th>
                <th>Title</th>
                <th class="hide-narrow">Year</th>
                <th class="hide-narrow">Status</th>
                <th class="num hide-narrow">Tracks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in Albums)
            {
                <tr @key="album.Id" class="arrives @(album.Ignored ? "dim" : "")">
                    <td class="cover-col"><a href="@Format.AlbumHref(album)" tabindex="-1"><Cover Url="@album.CoverUrl" /></a></td>
                    <td>
                        <a href="@Format.AlbumHref(album)">@album.Title</a>
                        @if (ShowSecondary && album.SecondaryTypes.Count > 0)
                        {
                            <span class="muted small"> · @Format.Secondary(album.SecondaryTypes)</span>
                        }
                        <div class="show-narrow"><StatusBadge Album="album.Status" /></div>
                    </td>
                    <td class="hide-narrow muted">@Format.Year(album.FirstReleaseDate)</td>
                    <td class="hide-narrow"><StatusBadge Album="album.Status" /></td>
                    <td class="num hide-narrow muted">@Format.Tracks(album)</td>
                    <td class="num actions">
                        @{
                            var missing = album.Status == AlbumStatus.Missing;
                            // Getting it and ignoring it are in the menu, while it can be got and isn't ignored.
                            var gettable = !album.Ignored && album.Status is AlbumStatus.Partial or AlbumStatus.Missing;
                            RenderFragment play = @<text>
                                @if (missing)
                                {
                                    <WishButton Kind="RequestKind.Album" Id="album.Id">
                                        <IconButton Icon="listen" Requires="@UserPermissions.Listen" Title="Listen: fetch it to play now, without adding it to your library" OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                    </WishButton>
                                }
                                else
                                {
                                    <IconButton Icon="play" Requires="@UserPermissions.Listen" Title="@(album.Status == AlbumStatus.Partial ? "Play, fetching the tracks you don't have to listen to" : "Play")"
                                                OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                }
                                <ItemMenu What="album" AlbumId="album.Id" AlbumStatus="album.Status" Name="@album.Title" Wish="@(missing || album.Status == AlbumStatus.Partial ? (RequestKind.Album, album.Id) : null)"
                                          Upgrade="@(album.Status is AlbumStatus.Complete or AlbumStatus.Partial ? new FormatScope(FormatScopeKind.Album, album.Id) : null)"
                                          Get="@(gettable ? (RequestKind.Album, album.Id) : null)"
                                          GetLabel="@(album.Status == AlbumStatus.Partial ? "Get the tracks you're missing" : "Get it into your library")"
                                          OnIgnore="@(gettable && missing ? EventCallback.Factory.Create(this, () => OnIgnore.InvokeAsync(album)) : default)" />
                            </text>;
                        }
                        @if (album.Ignored)
                        {
                            <IconButton Icon="unignore" Requires="@UserPermissions.Request" Title="Unignore: count this album again" OnClick="() => OnIgnore.InvokeAsync(album)" />
                        }
                        else if (album.Status is AlbumStatus.Partial or AlbumStatus.Missing)
                        {
                            <FetchButton Kind="RequestKind.Album" Id="album.Id" Button="false">@play</FetchButton>
                        }
                        else
                        {
                            @play
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AlbumSummary> Albums { get; set; } = [];
    [Parameter] public EventCallback<AlbumSummary> OnIgnore { get; set; }
    [Parameter] public bool ShowSecondary { get; set; }
}
