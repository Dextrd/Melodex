@inject MelodexClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime Js

@*
    How to sign in to Melodex from a Subsonic player (#7): the server's address, your username, and an app password kept
    apart from your own, which you can see, replace or remove here. Players with OpenSubsonic's API key sign-in can use an
    API key instead.
*@
<section class="panel" aria-label="Subsonic players">
    <header class="panel-head">
        <div class="panel-title">
            <h2>Subsonic players</h2>
            <p class="muted small">
                Play your library in any Subsonic or OpenSubsonic app, such as Symfonium, Amperfy, Substreamer, Tempo or Feishin. They sign in
                with an app password, not your own: if a phone is lost, replace it here and your own password is safe.
            </p>
        </div>
    </header>
    <div class="panel-body">
        @if (!Auth.May(UserPermissions.Listen))
        {
            <p class="muted small">You can't listen in Melodex. The admin can let you, under Settings → Users.</p>
        }
        else if (_login is null)
        {
            <Loading />
        }
        else
        {
            <dl class="subsonic-login">
                <dt>Server</dt>
                <dd class="secret-box"><code>@Server</code><IconButton Icon="copy" Title="Copy" Confirm="true" OnClick="() => CopyAsync(Server)" /></dd>
                <dt>Username</dt>
                <dd class="secret-box"><code>@_login.Username</code><IconButton Icon="copy" Title="Copy" Confirm="true" OnClick="() => CopyAsync(_login.Username)" /></dd>
                <dt>App password</dt>
                <dd>
                    @if (_login.Password is { } password)
                    {
                        <div class="secret-box">
                            <code>@(_shown ? password : new string('•', password.Length))</code>
                            <IconButton Icon="@(_shown ? "hide" : "show")" Title="@(_shown ? "Hide" : "Show")" OnClick="() => _shown = !_shown" />
                            <IconButton Icon="copy" Title="Copy" Confirm="true" OnClick="() => CopyAsync(password)" />
                        </div>
                        <span class="muted small">Made @Format.Ago(_login.CreatedAt ?? DateTime.UtcNow).</span>
                    }
                    else
                    {
                        <span class="muted small">None yet.</span>
                    }
                </dd>
            </dl>
            @if (_error is not null) { <p class="error small">@_error</p> }
            <div class="toolbar">
                @if (_login.Password is null)
                {
                    <button class="primary small" disabled="@_busy" @onclick="NewAsync">Make an app password</button>
                }
                else
                {
                    <button class="small" disabled="@_busy" @onclick="() => _confirm = Confirm.Replace">Replace</button>
                    <button class="small danger" disabled="@_busy" @onclick="() => _confirm = Confirm.Remove">Remove</button>
                }
            </div>
            @if (Auth.May(UserPermissions.Keys))
            {
                <p class="muted small">
                    A player that signs in with an API key can use one of yours with the Listen permission instead: make it under
                    <a href="settings/api">Settings → API</a>.
                </p>
            }
        }
    </div>
</section>

@if (_confirm is { } confirm)
{
    <Dialog Title="@(confirm == Confirm.Replace ? "Replace your app password?" : "Remove your app password?")" OnClose="() => _confirm = null" Alert="true">
        <p>
            Players signed in with it stop playing until they're given
            @(confirm == Confirm.Replace ? "the new one" : "a new one, if you make one"). Players using an API key carry on.
        </p>
        <div class="toolbar dialog-buttons">
            <button @onclick="() => _confirm = null">Cancel</button>
            <button class="danger" disabled="@_busy" @onclick="() => confirm == Confirm.Replace ? NewAsync() : RemoveAsync()">
                @(confirm == Confirm.Replace ? "Replace" : "Remove")
            </button>
        </div>
    </Dialog>
}

@code {
    private enum Confirm { Replace, Remove }

    private SubsonicLogin? _login;
    private bool _shown, _busy;
    private Confirm? _confirm;
    private string? _error;

    /// <summary>The address players connect to: this one, without the web app's page.</summary>
    private string Server => Nav.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        if (Auth.May(UserPermissions.Listen))
            _login = await Api.GetSubsonicLoginAsync();
    }

    private async Task NewAsync() => await RunAsync(async () =>
    {
        _login = await Api.NewSubsonicPasswordAsync();
        _shown = true;
    });

    private async Task RemoveAsync() => await RunAsync(async () =>
    {
        await Api.RemoveSubsonicPasswordAsync();
        _login = _login! with { Password = null, CreatedAt = null };
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            _confirm = null;
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync(string text) => await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
}
