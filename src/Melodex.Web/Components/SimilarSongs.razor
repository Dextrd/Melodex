@inject MelodexClient Api

@*
    Songs like this one (#3), from the discovery plugins, on a song's page: only those the catalogue has, each saying
    whether you have it. The section is shut until it's opened, and only then are the plugins asked. Nothing shows when no
    discovery plugin finds songs; when none found any, the section says so.
*@
@if (_offered)
{
    <h2 class="section"><SectionToggle Open="Open" OnToggle="OnToggle">Similar songs</SectionToggle></h2>
    @if (!Open) { }
    else if (_similar is null)
    {
        <Loading Inline="true" Text="Asking the discovery plugins…" />
    }
    else if (_similar.Count > 0)
    {
        <SongList Songs="_similar" />
    }
    else if (_error is null)
    {
        <div class="muted small">No similar songs found: the discovery plugins don't know this one well enough yet.</div>
    }
    @if (Open && _error is not null) { <div class="muted small" role="status">Couldn't find similar songs: @_error</div> }
}

@code {
    [Parameter, EditorRequired] public Guid TrackId { get; set; }

    /// <summary>How many to show.</summary>
    [Parameter] public int Take { get; set; } = 15;

    /// <summary>Whether the section is open, so its songs are looked for and shown.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }

    private IReadOnlyList<DiscoveredSong>? _similar;
    private Guid? _loaded;
    private bool? _checked;
    private bool _offered;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (_checked is null)
            {
                _offered = (await Api.GetDiscoveryAsync()).SimilarSongs;
                _checked = true;
            }
            if (!_offered || !Open || TrackId == _loaded)
                return;
            (_loaded, _similar, _error) = (TrackId, null, null);
            var similar = await Api.ListSimilarSongsAsync(TrackId, Take);
            if (TrackId == _loaded)
                _similar = similar;
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            (_offered, _similar, _error) = (true, [], e.Message);
        }
    }
}
