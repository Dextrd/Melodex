@page "/settings/account"
@page "/account"
@layout SettingsLayout
@inject AuthState Auth
@inject MelodexClient Api

<PageTitle>Your account · Melodex</PageTitle>

@* Your own login and your login on each media server, then the ListenBrainz and Last.fm accounts your plays are sent
   to, and signing out at the foot. It heads Settings. *@
@if (Auth.Status is { } status)
{
    <p class="muted">
        Signed in as <strong>@status.Username</strong>@(status.IsAdmin ? ", the admin, who may do everything." : ".")
    </p>
    <UserEditor Self="true" />
    @if (Auth.May(UserPermissions.Listen))
    {
        <h2 id="scrobbling">Scrobbling</h2>
        <p class="muted small">
            Every song you play, here or in a Subsonic player, is kept in your <a href="history">history</a>. Link an account and it's sent there too,
            once it's played for half its length or four minutes; while one can't be reached, plays wait and are sent later.
        </p>
        <section class="panel" aria-label="Scrobbling">
            <div class="panel-body">
                <ScrobbleLinks />
            </div>
        </section>
    }

    <h2>Sign out</h2>
    <div class="card settings-card">
        <div class="setting-line">
            <span>Sign out of Melodex in this browser.</span>
            <span class="spacer"></span>
            <button class="danger" @onclick="SignOutAsync">Sign out</button>
        </div>
    </div>
}

@code {
    private async Task SignOutAsync()
    {
        await Api.SignOutAsync();
        Auth.Set(await Api.GetAuthStatusAsync());
    }
}
