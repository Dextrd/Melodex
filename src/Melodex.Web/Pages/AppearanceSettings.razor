@page "/settings/appearance"
@layout SettingsLayout
@inject AuthState Auth

<PageTitle>Appearance · Melodex</PageTitle>

@*
    Your own look, and for whoever may change settings, everyone's too: what people see until they choose their own. It's
    the one panel, with a switch at its top right between the two.
*@
@if (Auth.May(UserPermissions.Settings))
{
    <AppearancePanel ForEveryone="_everyone">
        <Switch>
            <Segmented T="bool" Value="_everyone" Options="Whose" OnChange="v => _everyone = v" Label="Whose look" Class="panel-switch" />
        </Switch>
    </AppearancePanel>
}
else
{
    <AppearancePanel />
}

@code {
    private bool _everyone;

    private static readonly IReadOnlyList<(bool, string, string?)> Whose =
    [
        (false, "You", "How Melodex looks for you"),
        (true, "Everyone", "How Melodex looks for everyone who hasn't chosen their own"),
    ];
}
