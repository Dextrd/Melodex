@page "/account/scrobbling/{Service:guid}"
@inject MelodexClient Api
@inject NavigationManager Nav

<PageTitle>Linking · Melodex</PageTitle>

@*
    Where a scrobbling service that links on its own page, such as Last.fm, sends you back once you've allowed Melodex,
    with a token that's turned into the link.
*@
<h1>Linking your account</h1>
@if (_error is not null)
{
    <div class="notice warning" role="alert">@_error</div>
    <p><a href="account#scrobbling">Back to your account</a></p>
}
else
{
    <Loading />
}

@code {
    [Parameter] public Guid Service { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _error = "The service didn't send a token back. Try linking again.";
            return;
        }
        try
        {
            await Api.LinkScrobblingAsync(Service, Token);
            Nav.NavigateTo("account#scrobbling", replace: true);
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
    }
}
