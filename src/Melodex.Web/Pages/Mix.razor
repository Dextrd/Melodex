@page "/mixes/{Id:guid}"
@inject MelodexClient Api
@inject Player Player
@inject Notices Notices
@inject AuthState Auth
@inject RequestTracker Tracker
@inject Preferences Preferences

@*
    A mix made for you (#5): its songs, to play from any of them, those you don't have fetched to listen to as they come
    near. Keep copies it into a playlist of yours, as it is today, since the mix is remade tomorrow, or next Monday, and
    offers to get the songs you don't have, unless you've said not to ask again. Kept, the same button offers to delete
    the playlist, warning when it's been changed since.
*@

<PageTitle>@(_mix?.Mix.Name ?? "Mix") · Melodex</PageTitle>

<h1>Library</h1>
<LibraryTabs Current="for-you" />

@if (_gone)
{
    <div class="empty card">This mix has been remade since. <a href="">Your new mixes</a> are on For you.</div>
}
else if (_mix is not { } detail)
{
    <Loading />
}
else
{
    var mix = detail.Mix;
    <div class="page-head">
        <PlaylistCover Covers="mix.Covers" />
        <div>
            <h2 class="title">@mix.Name</h2>
            <div class="row muted small">
                <span>@(mix.Kind == MixKind.Daily ? "Made for you today" : "Made for you this week")</span>
                <span>@Format.Count(mix.Songs, "song", "songs")</span>
                @if (mix.Artists.Count > 0) { <span>@string.Join(", ", mix.Artists)</span> }
            </div>
            <div class="row album-actions" style="margin-top: .5rem;">
                <IconButton Icon="play" Requires="@UserPermissions.Listen" Primary="true" Large="true" Label="Play" Title="Play it from the start"
                            OnClick="() => Player.PlayMixAsync(detail)" />
                @if (mix.Kept is { } kept)
                {
                    <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Large="true" Label="Kept" On="true"
                                Title="@($"Kept as {kept.Name}: click to delete that playlist")" Disabled="_keeping" OnClick="() => _unkeeping = kept" />
                }
                else
                {
                    <IconButton Icon="playlist" Requires="@UserPermissions.Listen" Large="true" Label="Keep" Title="Keep it as it is today, as a playlist of yours"
                                Disabled="_keeping" OnClick="KeepAsync" />
                }
                <IconButton Icon="radio" Requires="@UserPermissions.Listen" Large="true" Title="Start radio: songs like the mix's, without end"
                            OnClick="() => Player.StartRadioAsync(mix.Id)" />
            </div>
            @if (_error is not null) { <div class="error small">@_error</div> }
        </div>
    </div>

    <SongList Songs="detail.Songs" PlayFrom="at => Player.PlayMixAsync(detail, at)" />
}

@if (_unkeeping is { } unkeeping)
{
    <Dialog Title="@($"Delete {unkeeping.Name}?")" Alert="true" OnClose="() => _unkeeping = null">
        <p>
            The playlist you kept this mix as is deleted, from your media server too if it's synced there. The mix stays,
            so you can keep it again while it lasts.
        </p>
        @if (unkeeping.Changed)
        {
            <p class="warning">
                You've changed the playlist since you kept it, renaming it or adding, taking out or moving songs. Those
                changes go with it.
            </p>
        }
        <div class="toolbar">
            <span class="spacer"></span>
            <button @onclick="() => _unkeeping = null">Keep it</button>
            <button class="danger" disabled="@_keeping" @onclick="UnkeepAsync">@if (_keeping) { <span class="spinner"></span> }Delete</button>
        </div>
    </Dialog>
}

@if (_asking is { } asking)
{
    <Dialog Title="@($"Get the {Format.Count(asking.Songs.Count, "song", "songs")} you don't have?")" Alert="true" OnClose="() => AnswerAsync(false)">
        <p>
            @asking.Playlist.Playlist.Name has @Format.Count(asking.Songs.Count, "song that isn't", "songs that aren't") in your library yet.
            Get @(asking.Songs.Count == 1 ? "it" : "them") now and each fills its place in the playlist as it arrives, or get
            @(asking.Songs.Count == 1 ? "it" : "them") later from the playlist.
        </p>
        <label class="auth-check">
            <input type="checkbox" @bind="_dontAsk" />
            <span>
                Don't ask again
                <span class="muted small">Keeping a mix won't offer this again in this browser.</span>
            </span>
        </label>
        <div class="toolbar">
            <span class="spacer"></span>
            <button @onclick="() => AnswerAsync(false)">Not now</button>
            <button class="primary" disabled="@_keeping" @onclick="() => AnswerAsync(true)">
                @if (_keeping) { <span class="spinner"></span> }Get @Format.Count(asking.Songs.Count, "song", "songs")
            </button>
        </div>
    </Dialog>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private MixDetail? _mix;
    private bool _gone, _keeping, _dontAsk;
    private string? _error;

    // A mix just kept, with the songs in it you don't have and haven't asked for, while asking whether to get them.
    private (PlaylistDetail Playlist, IReadOnlyList<Guid> Songs)? _asking;

    private const string DontAskKey = "mixes.dontAskToGet";

    // The playlist it was kept as, while asking whether to delete it.
    private KeptMix? _unkeeping;

    protected override async Task OnParametersSetAsync()
    {
        if (_mix?.Mix.Id == Id)
            return;
        (_mix, _gone) = (null, false);
        _mix = await Api.GetMixAsync(Id);
        _gone = _mix is null;
    }

    private async Task KeepAsync()
    {
        (_keeping, _error) = (true, null);
        try
        {
            var kept = await Api.KeepMixAsync(Id, new KeepMix());
            if (_mix is { } mix)
                _mix = mix with { Mix = mix.Mix with { Kept = new KeptMix(kept.Playlist.Id, kept.Playlist.Name, false) } };
            Notices.Show(new Notice($"mix:{Id}", NoticeKind.Action, "Kept as a playlist", kept.Playlist.Name, $"playlists/{kept.Playlist.Id}", "playlist"),
                always: true);
            if (Auth.May(UserPermissions.Request) && !await Preferences.GetAsync(DontAskKey, false))
            {
                await Tracker.EnsureLoadedAsync();
                var missing = kept.Songs
                    .Where(s => s.State == PlaylistSongState.Awaiting && s.TrackId is not null && Tracker.Find(RequestKind.Track, s.TrackId.Value) is null)
                    .Select(s => s.TrackId!.Value).Distinct().ToList();
                if (missing.Count > 0)
                    (_asking, _dontAsk) = ((kept, missing), false);
            }
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = $"Couldn't keep it: {e.Message}";
        }
        _keeping = false;
    }

    private async Task UnkeepAsync()
    {
        (_keeping, _error) = (true, null);
        try
        {
            await Api.UnkeepMixAsync(Id);
            if (_mix is { } mix)
                _mix = mix with { Mix = mix.Mix with { Kept = null } };
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = $"Couldn't delete it: {e.Message}";
        }
        (_keeping, _unkeeping) = (false, null);
    }

    private async Task AnswerAsync(bool get)
    {
        if (_asking is not { } asking || _keeping)
            return;
        if (_dontAsk)
            await Preferences.SetAsync(DontAskKey, true);
        if (get)
        {
            _keeping = true;
            try
            {
                foreach (var track in asking.Songs)
                    await Tracker.CreateAsync(new CreateRequest(RequestKind.Track, track));
            }
            catch (Exception e) when (e is HttpRequestException or MelodexApiException)
            {
                _error = $"Couldn't get them all: {e.Message}";
            }
            _keeping = false;
        }
        _asking = null;
    }
}
