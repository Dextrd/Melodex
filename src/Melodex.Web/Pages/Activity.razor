@page "/activity"
@page "/activity/{Tab}"
@implements IDisposable
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject ServerEvents Events
@inject Preferences Prefs
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AuthState Auth
@using Microsoft.JSInterop

<PageTitle>Activity · Melodex</PageTitle>

@*
    What Melodex is doing and has done, in two tabs: tasks such as scans, formatting and catalogue updates; and
    fetches, into the library or just to listen to. Each shows what's recent (still going, or changed in the last
    hour) or what's earlier.
*@
<h1>Activity</h1>
<nav class="page-tabs" aria-label="Activity">
    @foreach (var (tab, label, count) in Tabs)
    {
        <a href="activity/@tab" class="@(Shown == tab ? "active" : null)" aria-current="@(Shown == tab ? "page" : null)">
            @label@if (count > 0) { <span class="tab-count">@count</span> }
        </a>
    }
</nav>

<p class="muted">
    @switch (Shown)
    {
        case "tasks":
            <span>Scans, formatting, lyrics, visualiser bars, quality checks and catalogue updates.</span>
            break;
        case "fetches":
            <span>Artists, albums, songs and upgrades asked for, and songs fetched to listen to now, newest first. Open one to see each attempt, its log, and the other candidates a plugin offered.</span>
            break;
    }
</p>

<div class="toolbar">
    <Segmented T="bool" Value="_recent" Options="Times" OnChange="ShowRecentAsync" Label="Show" />
    <input class="filter" type="search" placeholder="@(Shown == "tasks" ? "Filter by title" : "Filter by song, album or artist")" aria-label="Filter"
           @bind="_filter" @bind:event="oninput" />
    <SortMenu Options="SortOptions" Value="@_sort" Descending="_descending" DirectionHint="@DirectionHint"
              OnChange="@(key => SortAsync(key, key == "newest"))" OnReverse="() => SortAsync(_sort, !_descending)" />
    @if (_loaded && MayChange && Changeable.Count > 0)
    {
        var which = _filter.Length > 0 ? "these" : "all";
        @if (Changeable.All(i => i.Paused))
        {
            <IconButton Icon="play" Label="@($"Resume {which}")" Title="@($"Let {Format.Count(Changeable.Count, Noun, Nouns)} go again")" Disabled="_busy"
                        OnClick="() => ChangeAsync(BulkAction.Resume)" />
        }
        else
        {
            <IconButton Icon="pause" Label="@($"Pause {which}")" Title="@($"Hold back {Format.Count(Changeable.Count(i => !i.Paused), Noun, Nouns)} until resumed")"
                        Disabled="_busy" OnClick="() => ChangeAsync(BulkAction.Pause)" />
        }
        <IconButton Icon="cancel" Label="@($"Cancel {which}")" Title="@($"Cancel {Format.Count(Changeable.Count, Noun, Nouns)}")" Disabled="_busy"
                    OnClick="() => _confirmCancel = true" />
    }
    @if (_loaded && Shown != "tasks" && Auth.May(UserPermissions.Request) && FailedCount > 0)
    {
        <IconButton Icon="retry" Label="Retry failed" Title="@($"Ask again for {Format.Count(FailedCount, "fetch that failed", "fetches that failed")}, as Retry does for each")"
                    Disabled="_busy" OnClick="RetryFailedAsync" />
    }
</div>
@if (_loaded && Shown != "tasks" && Auth.May(UserPermissions.Request) && FailedCount > 0)
{
    <ScheduleNote Task="ScheduledTask.RetryFailed" />
}

@if (Shown == "fetches" && _upgradeRun is { } run)
{
    <div class="notice upgrade-run" role="status">
        <span class="spinner" aria-hidden="true"></span>
        <span>
            Looking through the library for upgrades@(run.ByHand ? "" : " on the schedule"): @Format.Count(run.Asked, "song", "songs") asked for so far@(run.Until is { } until ? $", until {until.ToLocalTime():HH:mm}" : "").
        </span>
        @if (Auth.May(UserPermissions.Request))
        {
            <button class="small" disabled="@_busy" @onclick="StopUpgradesAsync">Stop looking</button>
        }
    </div>
}

@if (_confirmCancel)
{
    <Dialog Title="@($"Cancel {Format.Count(Changeable.Count, Noun, Nouns)}?")" OnClose="() => _confirmCancel = false" Alert="true">
        <p>
            @(Shown == "tasks"
                ? "Each stops for good. What a task has done already stays done."
                : "Each stops for good, with its parts. Files already in the library stay; songs fetched to listen to go.")
        </p>
        <div class="toolbar dialog-buttons">
            <button @onclick="() => _confirmCancel = false">Keep them</button>
            <button class="danger" disabled="@_busy" @onclick="() => ChangeAsync(BulkAction.Cancel)">@if (_busy) { <span class="spinner"></span> }Cancel them</button>
        </div>
    </Dialog>
}

@if (!_loaded)
{
    _hasEnd = false;
    <Loading />
}
else if (!Visible.Any())
{
    _hasEnd = false;
    <div class="empty card">
        @if (_filter.Length > 0) { <span>Nothing matches.</span> }
        else if (_recent)
        {
            <span>Nothing in the last hour. </span>
            <button class="link" @onclick="() => ShowRecentAsync(false)">Show earlier</button>
        }
        else if (Shown == "tasks") { <span>Nothing earlier. Scan the library from its page.</span> }
        else { <span>Nothing earlier. Use the Get buttons on artist, album and search pages.</span> }
    </div>
}
else
{
    var drawn = 0;
    <div class="activity-list" @ref="_list">
    @foreach (var (section, items) in Grouped)
    {
        @if (section is { } part)
        {
            var closed = _closed.Contains(SectionKey(part));
            <h2 class="activity-section">
                <button class="request-toggle" aria-expanded="@(closed ? "false" : "true")" @onclick="() => ToggleSectionAsync(part)">
                    <span class="chevron @(closed ? "" : "open")" aria-hidden="true"></span>
                    <span>@SectionLabel(part)</span><span class="tab-count">@items.Count</span>
                </button>
            </h2>
            @if (closed)
            {
                continue;
            }
        }
        <div class="card">
        @foreach (var item in items)
        {
            @if (drawn++ >= _shown)
            {
                break;
            }
            @if (item.Task is { } task)
            {
                var isScan = task.Kind == "library-scan";
                var canOpen = Opens.Contains(task.Kind);
                var taskOpen = canOpen && (_openTasks.TryGetValue(task.Id, out var opened) ? opened : task.Active);
                <div class="request" id="task-@task.Id" data-flip="task-@task.Id" @key="task.Id">
                    <div class="request-head">
                        @if (canOpen)
                        {
                            <button class="request-toggle" aria-expanded="@(taskOpen ? "true" : "false")" @onclick="() => _openTasks[task.Id] = !taskOpen">
                                <span class="chevron @(taskOpen ? "open" : "")" aria-hidden="true"></span>
                                <span class="request-title">@task.Title</span>
                            </button>
                        }
                        else
                        {
                            <span class="request-toggle">
                                <span aria-hidden="true"></span>
                                <span class="request-title">@task.Title</span>
                            </span>
                        }
                        <span class="muted small request-kind hide-narrow">@KindLabel(task.Kind)</span>
                        <span class="request-state"><span class="badge @Format.TaskBadge(task)">@Format.TaskLabel(task)</span></span>
                        <span class="muted small request-time hide-narrow" title="@task.UpdatedAt.ToLocalTime()">@Format.Ago(task.UpdatedAt)</span>
                        <span class="request-actions"><TaskActions Item="task" Queue="TaskQueue" OnChanged="TasksChangedAsync" /></span>
                    </div>
                    @if (task.Error is not null) { <div class="small request-detail error">@task.Error</div> }
                    else if (task.Progress is not null) { <div class="muted small request-detail">@task.Progress</div> }
                    @if (taskOpen)
                    {
                        <div class="request-body">
                            @if (isScan) { <ScanFiles Task="task.Id" Active="task.Active" /> }
                            else { <TaskRowList Task="task.Id" Active="task.Active" /> }
                        </div>
                    }
                </div>
                continue;
            }
            var request = item.Request!;
            var open = _open.ContainsKey(request.Id);
            <div class="request" id="request-@request.Id" data-flip="request-@request.Id" @key="request.Id">
                <div class="request-head">
                    <div class="request-toggle with-cover" @onclick="() => ToggleAsync(request.Id)">
                        <button class="chevron-button" aria-expanded="@(open ? "true" : "false")" aria-label="@(open ? "Hide its attempts" : "Show its attempts")"
                                @onclick="() => ToggleAsync(request.Id)" @onclick:stopPropagation="true">
                            <span class="chevron @(open ? "open" : "")" aria-hidden="true"></span>
                        </button>
                        <Cover Url="@request.Target?.CoverUrl" Artist="@(request.Kind == RequestKind.Artist)" />
                        <span class="request-title">@RequestTitle(request)</span>
                    </div>
                    <span class="muted small request-kind hide-narrow">@(request.ListenNow ? "Listen now" : request.Upgrade ? "Upgrade" : request.Replace ? "Replace" : request.Kind.ToString())</span>
                    <span class="request-state"><span class="badge @Format.RequestBadge(request)">@Format.RequestLabel(request)</span></span>
                    <span class="muted small request-time hide-narrow" title="@request.UpdatedAt.ToLocalTime()">@Format.Ago(request.UpdatedAt)</span>
                    <span class="request-actions"><Actions Request="request" Queue="@(request.ListenNow ? null : RequestQueue)" OnChanged="ChangedAsync" /></span>
                </div>
                @* A listen-now song that's gone says so in its badge; "Ready to play" would say otherwise. *@
                @if (request.Detail is not null && !(request.Paused && request.Detail == "Paused") && request.Ended is null) { <div class="muted small request-detail">@request.Detail</div> }
                @if (request.Parts is { Total: > 0 } parts)
                {
                    <div class="meter request-meter" title="@parts.InLibrary of @parts.Total in the library"><span style="width: @(100 * parts.InLibrary / parts.Total)%"></span></div>
                }
                @if (open && _open[request.Id] is { } detail)
                {
                    <RequestDetail Request="detail" OnChanged="ChangedAsync" />
                }
            </div>
        }
        </div>
    }
    </div>
    @* The rest come as it's scrolled to: those already loaded, then, among earlier downloads, the ones before them. *@
    _hasEnd = Drawable.Count() > _shown || (Shown == "fetches" && !_recent && Tracker.HasEarlier);
    @if (_hasEnd)
    {
        <div class="list-end muted small" @ref="_end"><span class="spinner"></span> Loading more…</div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "open")] public Guid? OpenId { get; set; }

    /// <summary>tasks or fetches, from the address; the one last shown when it doesn't say.</summary>
    [Parameter] public string? Tab { get; set; }

    private const string TabKey = "activity.tab", RecentKey = "activity.recent", SortKey = "activity.sort", DescendingKey = "activity.descending",
        ClosedKey = "activity.closed";

    // Newest: what's going first, then the rest as they last changed. The others go by name.
    private IReadOnlyList<(string Key, string Label)> SortOptions => Shown == "tasks"
        ? [("newest", "Newest"), ("name", "Title")]
        : [("newest", "Newest"), ("name", "Title"), ("artist", "Artist"), ("album", "Album")];

    private string _sort = "newest";
    private bool _descending = true;

    private string DirectionHint => _sort == "newest"
        ? $"{(_descending ? "Newest" : "Oldest")} first; click to reverse"
        : $"Sorted {(_descending ? "Z to A" : "A to Z")}; click to reverse";

    private async Task SortAsync(string key, bool descending)
    {
        (_sort, _descending) = (key, descending);
        await Prefs.SetAsync(SortKey, key);
        await Prefs.SetAsync(DescendingKey, descending);
    }

    // A request's song, album or artist, each a link, as the catalogue has them; its title as it was asked for otherwise.
    private static RenderFragment RequestTitle(RequestInfo request) => request.Target is not { } target
        ? @<text>@request.Title</text>
        : @<text>
            <a href="@(request.Kind switch { RequestKind.Artist => "artists", RequestKind.Album => "albums", _ => "tracks" })/@request.TargetId" @onclick:stopPropagation="true">@target.Name</a>
            @if (request.Kind != RequestKind.Artist && target.ArtistId is { } artist)
            {
                <span class="request-by small ellipsis">
                    <a class="by" href="artists/@artist" @onclick:stopPropagation="true">@target.ArtistName</a>
                    @if (request.Kind == RequestKind.Track && target.AlbumId is { } album)
                    {
                        <span class="muted"> · </span><a class="by" href="albums/@album" @onclick:stopPropagation="true">@target.AlbumTitle</a>
                    }
                </span>
            }
        </text>;
    private string _remembered = "fetches";
    private string Shown => Tab is "tasks" or "fetches" ? Tab : _remembered;

    // Tabs with how many things in each are still going.
    private IEnumerable<(string Tab, string Label, int Count)> Tabs =>
    [
        ("tasks", "Tasks", _tasks.Count(t => t.Active)),
        ("fetches", "Fetches", Tracker.Requests.Count(r => r.Active)),
    ];

    private bool _loaded;

    // How many rows are drawn; more as the list's end is scrolled to, so a long one stays quick.
    private const int Step = 100;
    private int _shown = Step;
    private ElementReference _end;
    private DotNetObjectReference<Activity>? _self;
    private bool _disposed;
    private bool _hasEnd;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moving)
        {
            _moving = false;
            await Js.InvokeVoidAsync("melodexFlip.play", _list);
        }
        await LandAsync();
        if (!_hasEnd)
            return;
        // Left while it landed: its reference is gone.
        if (_disposed)
            return;
        _self ??= DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("melodexScroll.atEnd", _end, _self);
    }

    /// <summary>The list's end has come into view: draws more, loading earlier downloads once all loaded are drawn.</summary>
    [JSInvokable]
    public async Task MoreAsync()
    {
        if (Drawable.Count() > _shown)
            _shown += Step;
        else if (Shown == "fetches" && !_recent && Tracker.HasEarlier)
        {
            var had = Tracker.Requests.Count;
            await Tracker.LoadEarlierAsync();
            if (Tracker.Requests.Count == had)
                return;
        }
        else
            return;
        StateHasChanged();
    }

    // The newest scan opens while it runs; a click overrides that.
    // Tasks opened or closed here; the rest are open while they run.
    private readonly Dictionary<Guid, bool> _openTasks = [];

    // Kinds of task that show what they're doing, row by row.
    private static readonly HashSet<string> Opens = ["library-scan", "library-format", "library-lyrics", "artist-refresh", "catalogue-update", "tools-import"];
    private static readonly IReadOnlyList<(bool Value, string Label, string? Hint)> Times =
        [(true, "Recent", "Still going, or changed in the last hour"), (false, "Earlier", "Everything before that")];

    private bool _recent = true;

    // What a task is, in a word.
    private static string KindLabel(string kind) => kind switch
    {
        "library-scan" => "Scan",
        "library-format" => "Format",
        "library-lyrics" => "Lyrics",
        "library-bars" => "Bars",
        "library-spectrum" => "Quality",
        "tools-import" => "Import",
        _ => "Catalogue",
    };

    private async Task ShowRecentAsync(bool recent)
    {
        _recent = recent;
        await Prefs.SetAsync(RecentKey, recent);
    }

    private static bool IsRecent(bool active, DateTime updatedAt) => active || updatedAt > DateTime.UtcNow.AddHours(-1);
    private string _filter = "";
    private IReadOnlyList<TaskInfo> _tasks = [];
    private Timer? _timer;

    /// <summary>A request or a background task, in one list.</summary>
    private bool _busy, _confirmCancel;

    // Pause all and Cancel all act on what's shown and still going, with the permission for the tab's kind.
    private bool MayChange => Auth.May(Shown == "tasks" ? UserPermissions.Scan : UserPermissions.Request);
    private List<Item> Changeable => Visible.Where(i => i.Active).ToList();
    private string Noun => Shown == "tasks" ? "task" : "fetch";
    private string Nouns => Shown == "tasks" ? "tasks" : "fetches";

    // Failed downloads asked for into the library, which Retry failed asks for again: not upgrades, replacements or listening.
    private int FailedCount => Tracker.Requests.Count(r => r.State == RequestState.Failed && r.ParentId is null && !r.ListenNow && !r.Upgrade && !r.Replace);

    private async Task RetryFailedAsync()
    {
        _busy = true;
        try
        {
            await Api.RetryFailedRequestsAsync();
            await Tracker.RefreshAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeAsync(BulkAction action)
    {
        _busy = true;
        try
        {
            var change = new BulkChange(action, Changeable.Select(i => i.Request?.Id ?? i.Task!.Id).ToList());
            if (Shown == "tasks")
            {
                await Api.ChangeTasksAsync(change);
                await LoadTasksAsync();
            }
            else
            {
                await Api.ChangeRequestsAsync(change);
                await Tracker.RefreshAsync();
            }
        }
        finally
        {
            _busy = false;
            _confirmCancel = false;
        }
    }

    private sealed record Item(DateTime UpdatedAt, RequestInfo? Request = null, TaskInfo? Task = null)
    {
        public bool Active => Request?.Active ?? Task!.Active;
        public bool Paused => Request?.Paused ?? Task!.Paused;
        public string Title => Request?.Title ?? Task!.Title ?? Task.Kind;

        /// <summary>Working on it now, rather than waiting its turn or paused.</summary>
        public bool Running => Request is { } r ? r.State != RequestState.Queued && !r.Paused : Task!.State == TaskState.Running;

        public double QueueOrder => Request?.QueueOrder ?? Task!.QueueOrder;

        /// <summary>Whether its title, or the song, album or artist it's for, has the text in it.</summary>
        public bool Matches(string text) =>
            new[] { Title, Request?.Target?.Name, Request?.Target?.ArtistName, Request?.Target?.AlbumTitle }
                .Any(s => s?.Contains(text, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    /// <summary>Requests waiting or running, in queue order, to move them up and down.</summary>
    private IReadOnlyList<RequestInfo> RequestQueue =>
        Tracker.Requests.Where(r => r.Active && !r.ListenNow).OrderBy(r => r.QueueOrder).ThenBy(r => r.CreatedAt).ToList();

    /// <summary>Tasks waiting their turn, in the order they'll run.</summary>
    private IReadOnlyList<TaskInfo> TaskQueue =>
        _tasks.Where(t => t.State == TaskState.Queued).OrderBy(t => t.QueueOrder).ThenBy(t => t.CreatedAt).ToList();

    // Open requests, with their parts and jobs once loaded.
    private readonly Dictionary<Guid, RequestInfo?> _open = [];

    // The tab's: what's running, then what's waiting in queue order, then the rest, most recently changed first.
    // Fetches has every fetch, listen-now ones too; Library → Listen now is for playing what they fetched.
    private IEnumerable<Item> Visible
    {
        get
        {
            var items = (Shown == "tasks"
                    ? _tasks.Select(t => new Item(t.UpdatedAt, Task: t))
                    : Tracker.Requests.Select(r => new Item(r.UpdatedAt, Request: r)))
                .Where(i => IsRecent(i.Active, i.UpdatedAt) == _recent)
                .Where(i => _filter.Length == 0 || i.Matches(_filter))
                .ToList();
            // Recent is in sections, each sorted on its own; Earlier is all finished.
            return _recent ? Sections.SelectMany(part => Sorted(items.Where(i => SectionOf(i) == part))) : Sorted(items);
        }
    }

    // The look through the library for upgrades that's going, read now and then as downloads change.
    private UpgradeRunInfo? _upgradeRun;
    private DateTime _upgradeRunRead;

    private async Task LoadUpgradeRunAsync(bool now = false)
    {
        if (!now && DateTime.UtcNow - _upgradeRunRead < TimeSpan.FromSeconds(10))
            return;
        _upgradeRunRead = DateTime.UtcNow;
        try
        {
            _upgradeRun = await Api.GetUpgradeRunAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
        }
    }

    private async Task StopUpgradesAsync()
    {
        _busy = true;
        try
        {
            await Api.StopUpgradesAsync();
            await LoadUpgradeRunAsync(now: true);
            await Tracker.RefreshAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    // Newest: what's going in the order it runs, the next first, then the rest as they last changed. The others by name.
    private IEnumerable<Item> Sorted(IEnumerable<Item> items)
    {
        if (_sort != "newest")
        {
            Func<Item, string> key = _sort switch
            {
                "artist" => i => i.Request?.Target?.ArtistName ?? "",
                "album" => i => i.Request?.Target?.AlbumTitle ?? "",
                _ => i => i.Request?.Target?.Name ?? i.Title,
            };
            var text = StringComparer.CurrentCultureIgnoreCase;
            return _descending ? items.OrderByDescending(key, text) : items.OrderBy(key, text);
        }
        var list = items.ToList();
        var active = list.Where(i => i.Active)
            .OrderByDescending(i => i.Running).ThenBy(i => i.Request is not null).ThenBy(i => i.QueueOrder).ThenBy(i => i.UpdatedAt);
        var newest = active.Concat(list.Where(i => !i.Active).OrderByDescending(i => i.UpdatedAt));
        return _descending ? newest : newest.Reverse();
    }

    /// <summary>Recent's three sections, each of which can be closed.</summary>
    private enum Section { Running, Queued, Completed }

    private static readonly Section[] Sections = [Section.Running, Section.Queued, Section.Completed];

    private static Section SectionOf(Item item) => !item.Active ? Section.Completed : item.Running ? Section.Running : Section.Queued;

    private static string SectionLabel(Section section) => section switch
    {
        Section.Running => "Running",
        Section.Queued => "Queued",
        _ => "Completed",
    };

    // Kept per tab, so Tasks and Fetches each remember theirs.
    private string SectionKey(Section section) => $"{Shown}:{section}";

    private HashSet<string> _closed = [];

    private async Task ToggleSectionAsync(Section section)
    {
        if (!_closed.Remove(SectionKey(section)))
            _closed.Add(SectionKey(section));
        await Prefs.SetAsync(ClosedKey, _closed.ToList());
    }

    /// <summary>What's shown, in sections in Recent (those with anything in them), or all together in Earlier.</summary>
    private List<(Section? Section, List<Item> Items)> Grouped
    {
        get
        {
            var visible = Visible.ToList();
            return _recent
                ? Sections.Select(part => ((Section?)part, visible.Where(i => SectionOf(i) == part).ToList())).Where(g => g.Item2.Count > 0).ToList()
                : [(null, visible)];
        }
    }

    /// <summary>What can be drawn, leaving out closed sections, in the order it's drawn.</summary>
    private IEnumerable<Item> Drawable => _recent ? Visible.Where(i => !_closed.Contains(SectionKey(SectionOf(i)))) : Visible;

    private async Task TasksChangedAsync()
    {
        await LoadTasksAsync();
        await RedrawAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _remembered = await Prefs.GetAsync(TabKey, "fetches");
        // Fetches was Downloads.
        if (_remembered == "downloads")
            _remembered = "fetches";
        _recent = await Prefs.GetAsync(RecentKey, true);
        _sort = await Prefs.GetAsync(SortKey, "newest");
        _descending = await Prefs.GetAsync(DescendingKey, true);
        _closed = [.. await Prefs.GetAsync<List<string>>(ClosedKey, [])];
        Tracker.Changed += Refresh;
        Events.Received += OnEvent;
        await Task.WhenAll(Tracker.RefreshAsync(), LoadTasksAsync(), LoadUpgradeRunAsync(now: true));
        _loaded = true;
        // Tasks are polled here; requests by the tracker. Quicker while something's running.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (_tasks.Any(t => t.Active) || ++_idlePolls % 5 == 0)
            {
                await LoadTasksAsync();
                await RedrawAsync();
            }
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private int _idlePolls;

    // A scan or catalogue update that starts shows at once, not at the next idle poll.
    private void OnEvent(string type)
    {
        if (type is "tasks" or "connected")
            InvokeAsync(async () =>
            {
                await LoadTasksAsync();
                await RedrawAsync();
            });
    }

    private async Task LoadTasksAsync()
    {
        try
        {
            _tasks = await Api.ListTasksAsync(limit: 50);
        }
        catch (HttpRequestException)
        {
            // Keep what's shown; the next poll tries again.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Tab == "listen-now")
        {
            // Listen now moved to the Library (#121).
            Nav.NavigateTo("listen-now", replace: true);
            return;
        }
        if (Tab == "downloads")
        {
            // Downloads became Fetches; old links, with what they open, go there.
            Nav.NavigateTo("activity/fetches" + new Uri(Nav.Uri).Query, replace: true);
            return;
        }
        if (Tab is "tasks" or "fetches" && Tab != _remembered)
        {
            _remembered = Tab;
            await Prefs.SetAsync(TabKey, Tab);
        }
        if (OpenId is { } id && id != _landed)
        {
            // Where the link points: a request, or failing that a task. Either is shown open, scrolled to and flashed.
            _landed = id;
            if (await Api.GetRequestAsync(id) is not { } request)
            {
                await LoadTasksAsync();
                if (_tasks.FirstOrDefault(t => t.Id == id) is { } task)
                {
                    if (Tab is null)
                        _remembered = "tasks";
                    _recent = IsRecent(task.Active, task.UpdatedAt);
                    if (Opens.Contains(task.Kind))
                        _openTasks[id] = true;
                    _landing = $"task-{id}";
                }
                return;
            }
            // A link to a request shows it under Fetches, recent or earlier as it is.
            if (Tab is null)
                _remembered = "fetches";
            // A link to a part opens its parent too, if it's one.
            var top = request.ParentId is { } parent ? await Api.GetRequestAsync(parent) : request;
            if (top is not null)
                _recent = IsRecent(top.Active, top.UpdatedAt);
            if (request.ParentId is { } parentId)
                _open[parentId] = top;
            _open[id] = request;
            _landing = $"request-{top?.Id ?? id}";
        }
    }

    // The request or task a link named, and the row to scroll to and flash once it's drawn.
    private Guid? _landed;
    private string? _landing;

    // Draws enough of the list to include the row landed on, loading earlier downloads until it's there.
    private async Task LandAsync()
    {
        if (_landing is not { } row || !_loaded)
            return;
        _landing = null;
        var id = Guid.Parse(row[(row.IndexOf('-') + 1)..]);
        for (var tries = 0; tries < 50; tries++)
        {
            // The section it's in opens.
            if (_recent && Visible.FirstOrDefault(i => (i.Request?.Id ?? i.Task!.Id) == id) is { } landed)
                _closed.Remove(SectionKey(SectionOf(landed)));
            var index = Drawable.ToList().FindIndex(i => (i.Request?.Id ?? i.Task!.Id) == id);
            if (index >= 0)
            {
                _shown = Math.Max(_shown, (index / Step + 1) * Step);
                break;
            }
            if (Shown != "fetches" || _recent || !Tracker.HasEarlier)
                break;
            var had = Tracker.Requests.Count;
            await Tracker.LoadEarlierAsync();
            if (Tracker.Requests.Count == had)
                break;
        }
        StateHasChanged();
        await Js.InvokeVoidAsync("melodexScroll.land", row);
    }

    private void Refresh() => InvokeAsync(async () =>
    {
        // Open requests that are still moving are reloaded with the list, and once more after they stop: the list can
        // show one finished before its open copy has caught up, and that copy would keep its last attempt running.
        foreach (var id in _open.Keys.ToList())
            if (Tracker.Requests.FirstOrDefault(r => r.Id == id) is not { Active: false } || _open[id] is { Active: true }
                || _open[id]?.Children?.Any(c => c.Active) == true)
                _open[id] = await Api.GetRequestAsync(id);
        await LoadUpgradeRunAsync();
        await RedrawAsync();
    });

    private ElementReference _list;
    private bool _moving;

    // Redraws after the list changed, rows sliding from where they were to where they are now (flip.js).
    private async Task RedrawAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("melodexFlip.measure", _list);
            _moving = true;
        }
        catch (JSException)
        {
        }
        StateHasChanged();
    }

    private async Task ToggleAsync(Guid id)
    {
        if (!_open.Remove(id))
            _open[id] = await Api.GetRequestAsync(id);
    }

    private async Task ChangedAsync()
    {
        await Tracker.RefreshAsync();
        foreach (var id in _open.Keys.ToList())
            _open[id] = await Api.GetRequestAsync(id);
    }

    public void Dispose()
    {
        _disposed = true;
        _self?.Dispose();
        Tracker.Changed -= Refresh;
        Events.Received -= OnEvent;
        _timer?.Dispose();
    }
}
