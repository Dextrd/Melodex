@page "/activity"
@page "/activity/{Tab}"
@implements IDisposable
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject ServerEvents Events
@inject Preferences Prefs
@inject NavigationManager Nav

<PageTitle>Activity · Melodex</PageTitle>

@*
    What Melodex is doing and has done, in two tabs: tasks such as scans, formatting and catalogue updates; and
    downloads, into the library or just to listen to. Each shows what's recent (still going, or changed in the last
    hour) or what's earlier.
*@
<h1>Activity</h1>
<nav class="page-tabs" aria-label="Activity">
    @foreach (var (tab, label, count) in Tabs)
    {
        <a href="activity/@tab" class="@(Shown == tab ? "active" : null)" aria-current="@(Shown == tab ? "page" : null)">
            @label@if (count > 0) { <span class="tab-count">@count</span> }
        </a>
    }
</nav>

<p class="muted">
    @switch (Shown)
    {
        case "tasks":
            <span>Scans, formatting, lyrics, visualiser bars, quality checks and catalogue updates.</span>
            break;
        case "downloads":
            <span>Artists, albums, songs and upgrades asked for, and songs fetched to listen to now, newest first. Open one to see each attempt, its log, and the other candidates a plugin offered.</span>
            break;
    }
</p>

<div class="toolbar">
    <Segmented T="bool" Value="_recent" Options="Times" OnChange="ShowRecentAsync" Label="Show" />
    <input class="filter" type="search" placeholder="@(Shown == "tasks" ? "Filter by title" : "Filter by song, album or artist")" aria-label="Filter"
           @bind="_filter" @bind:event="oninput" />
    <SortMenu Options="SortOptions" Value="@_sort" Descending="_descending" DirectionHint="@DirectionHint"
              OnChange="@(key => SortAsync(key, key == "newest"))" OnReverse="() => SortAsync(_sort, !_descending)" />
</div>

@if (!_loaded)
{
    <Loading />
}
else if (!Visible.Any())
{
    <div class="empty card">
        @if (_filter.Length > 0) { <span>Nothing matches.</span> }
        else if (_recent)
        {
            <span>Nothing in the last hour. </span>
            <button class="link" @onclick="() => ShowRecentAsync(false)">Show earlier</button>
        }
        else if (Shown == "tasks") { <span>Nothing earlier. Scan the library from its page.</span> }
        else { <span>Nothing earlier. Use the Get buttons on artist, album and search pages.</span> }
    </div>
}
else
{
    <div class="card">
        @foreach (var item in Visible)
        {
            @if (item.Task is { } task)
            {
                var isScan = task.Kind == "library-scan";
                var canOpen = Opens.Contains(task.Kind);
                var taskOpen = canOpen && (_openTasks.TryGetValue(task.Id, out var opened) ? opened : task.Active);
                <div class="request">
                    <div class="request-head">
                        @if (canOpen)
                        {
                            <button class="request-toggle" aria-expanded="@(taskOpen ? "true" : "false")" @onclick="() => _openTasks[task.Id] = !taskOpen">
                                <span class="chevron @(taskOpen ? "open" : "")" aria-hidden="true"></span>
                                <span class="request-title">@task.Title</span>
                            </button>
                        }
                        else
                        {
                            <span class="request-toggle">
                                <span aria-hidden="true"></span>
                                <span class="request-title">@task.Title</span>
                            </span>
                        }
                        <span class="muted small request-kind hide-narrow">@KindLabel(task.Kind)</span>
                        <span class="request-state"><span class="badge @Format.TaskBadge(task)">@Format.TaskLabel(task)</span></span>
                        <span class="muted small request-time hide-narrow" title="@task.UpdatedAt.ToLocalTime()">@Format.Ago(task.UpdatedAt)</span>
                        <span class="request-actions"><TaskActions Item="task" Queue="TaskQueue" OnChanged="TasksChangedAsync" /></span>
                    </div>
                    @if (task.Error is not null) { <div class="small request-detail error">@task.Error</div> }
                    else if (task.Progress is not null) { <div class="muted small request-detail">@task.Progress</div> }
                    @if (taskOpen)
                    {
                        <div class="request-body">
                            @if (isScan) { <ScanFiles Task="task.Id" Active="task.Active" /> }
                            else { <TaskRowList Task="task.Id" Active="task.Active" /> }
                        </div>
                    }
                </div>
                continue;
            }
            var request = item.Request!;
            var open = _open.ContainsKey(request.Id);
            <div class="request">
                <div class="request-head">
                    <div class="request-toggle with-cover" @onclick="() => ToggleAsync(request.Id)">
                        <button class="chevron-button" aria-expanded="@(open ? "true" : "false")" aria-label="@(open ? "Hide its attempts" : "Show its attempts")"
                                @onclick="() => ToggleAsync(request.Id)" @onclick:stopPropagation="true">
                            <span class="chevron @(open ? "open" : "")" aria-hidden="true"></span>
                        </button>
                        <Cover Url="@request.Target?.CoverUrl" Artist="@(request.Kind == RequestKind.Artist)" />
                        <span class="request-title">@RequestTitle(request)</span>
                    </div>
                    <span class="muted small request-kind hide-narrow">@(request.ListenNow ? "Listen now" : request.Upgrade ? "Upgrade" : request.Kind.ToString())</span>
                    <span class="request-state"><span class="badge @Format.RequestBadge(request)">@Format.RequestLabel(request)</span></span>
                    <span class="muted small request-time hide-narrow" title="@request.UpdatedAt.ToLocalTime()">@Format.Ago(request.UpdatedAt)</span>
                    <span class="request-actions"><Actions Request="request" Queue="@(request.ListenNow ? null : RequestQueue)" OnChanged="ChangedAsync" /></span>
                </div>
                @* A listen-now song that's gone says so in its badge; "Ready to play" would say otherwise. *@
                @if (request.Detail is not null && !(request.Paused && request.Detail == "Paused") && request.Ended is null) { <div class="muted small request-detail">@request.Detail</div> }
                @if (request.Parts is { Total: > 0 } parts)
                {
                    <div class="meter request-meter" title="@parts.InLibrary of @parts.Total in the library"><span style="width: @(100 * parts.InLibrary / parts.Total)%"></span></div>
                }
                @if (open && _open[request.Id] is { } detail)
                {
                    <RequestDetail Request="detail" OnChanged="ChangedAsync" />
                }
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "open")] public Guid? OpenId { get; set; }

    /// <summary>tasks or downloads, from the address; the one last shown when it doesn't say.</summary>
    [Parameter] public string? Tab { get; set; }

    private const string TabKey = "activity.tab", RecentKey = "activity.recent", SortKey = "activity.sort", DescendingKey = "activity.descending";

    // Newest: what's going first, then the rest as they last changed. The others go by name.
    private IReadOnlyList<(string Key, string Label)> SortOptions => Shown == "tasks"
        ? [("newest", "Newest"), ("name", "Title")]
        : [("newest", "Newest"), ("name", "Title"), ("artist", "Artist"), ("album", "Album")];

    private string _sort = "newest";
    private bool _descending = true;

    private string DirectionHint => _sort == "newest"
        ? $"{(_descending ? "Newest" : "Oldest")} first; click to reverse"
        : $"Sorted {(_descending ? "Z to A" : "A to Z")}; click to reverse";

    private async Task SortAsync(string key, bool descending)
    {
        (_sort, _descending) = (key, descending);
        await Prefs.SetAsync(SortKey, key);
        await Prefs.SetAsync(DescendingKey, descending);
    }

    // A request's song, album or artist, each a link, as the catalogue has them; its title as it was asked for otherwise.
    private static RenderFragment RequestTitle(RequestInfo request) => request.Target is not { } target
        ? @<text>@request.Title</text>
        : @<text>
            <a href="@(request.Kind switch { RequestKind.Artist => "artists", RequestKind.Album => "albums", _ => "tracks" })/@request.TargetId" @onclick:stopPropagation="true">@target.Name</a>
            @if (request.Kind != RequestKind.Artist && target.ArtistId is { } artist)
            {
                <span class="request-by small ellipsis">
                    <a class="by" href="artists/@artist" @onclick:stopPropagation="true">@target.ArtistName</a>
                    @if (request.Kind == RequestKind.Track && target.AlbumId is { } album)
                    {
                        <span class="muted"> · </span><a class="by" href="albums/@album" @onclick:stopPropagation="true">@target.AlbumTitle</a>
                    }
                </span>
            }
        </text>;
    private string _remembered = "downloads";
    private string Shown => Tab is "tasks" or "downloads" ? Tab : _remembered;

    // Tabs with how many things in each are still going.
    private IEnumerable<(string Tab, string Label, int Count)> Tabs =>
    [
        ("tasks", "Tasks", _tasks.Count(t => t.Active)),
        ("downloads", "Downloads", Tracker.Requests.Count(r => r.Active)),
    ];

    private bool _loaded;

    // The newest scan opens while it runs; a click overrides that.
    // Tasks opened or closed here; the rest are open while they run.
    private readonly Dictionary<Guid, bool> _openTasks = [];

    // Kinds of task that show what they're doing, row by row.
    private static readonly HashSet<string> Opens = ["library-scan", "library-format", "library-lyrics", "artist-refresh"];
    private static readonly IReadOnlyList<(bool Value, string Label, string? Hint)> Times =
        [(true, "Recent", "Still going, or changed in the last hour"), (false, "Earlier", "Everything before that")];

    private bool _recent = true;

    // What a task is, in a word.
    private static string KindLabel(string kind) => kind switch
    {
        "library-scan" => "Scan",
        "library-format" => "Format",
        "library-lyrics" => "Lyrics",
        "library-bars" => "Bars",
        "library-spectrum" => "Quality",
        _ => "Catalogue",
    };

    private async Task ShowRecentAsync(bool recent)
    {
        _recent = recent;
        await Prefs.SetAsync(RecentKey, recent);
    }

    private static bool IsRecent(bool active, DateTime updatedAt) => active || updatedAt > DateTime.UtcNow.AddHours(-1);
    private string _filter = "";
    private IReadOnlyList<TaskInfo> _tasks = [];
    private Timer? _timer;

    /// <summary>A request or a background task, in one list.</summary>
    private sealed record Item(DateTime UpdatedAt, RequestInfo? Request = null, TaskInfo? Task = null)
    {
        public bool Active => Request?.Active ?? Task!.Active;
        public string Title => Request?.Title ?? Task!.Title ?? Task.Kind;

        /// <summary>Working on it now, rather than waiting its turn or paused.</summary>
        public bool Running => Request is { } r ? r.State != RequestState.Queued && !r.Paused : Task!.State == TaskState.Running;

        public double QueueOrder => Request?.QueueOrder ?? Task!.QueueOrder;

        /// <summary>Whether its title, or the song, album or artist it's for, has the text in it.</summary>
        public bool Matches(string text) =>
            new[] { Title, Request?.Target?.Name, Request?.Target?.ArtistName, Request?.Target?.AlbumTitle }
                .Any(s => s?.Contains(text, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    /// <summary>Requests waiting or running, in queue order, to move them up and down.</summary>
    private IReadOnlyList<RequestInfo> RequestQueue =>
        Tracker.Requests.Where(r => r.Active && !r.ListenNow).OrderBy(r => r.QueueOrder).ThenBy(r => r.CreatedAt).ToList();

    /// <summary>Tasks waiting their turn, in the order they'll run.</summary>
    private IReadOnlyList<TaskInfo> TaskQueue =>
        _tasks.Where(t => t.State == TaskState.Queued).OrderBy(t => t.QueueOrder).ThenBy(t => t.CreatedAt).ToList();

    // Open requests, with their parts and jobs once loaded.
    private readonly Dictionary<Guid, RequestInfo?> _open = [];

    // The tab's: what's running, then what's waiting in queue order, then the rest, most recently changed first.
    // Downloads has every fetch, listen-now ones too; Library → Listen now is for playing what they fetched.
    private IEnumerable<Item> Visible
    {
        get
        {
            var items = (Shown == "tasks"
                    ? _tasks.Select(t => new Item(t.UpdatedAt, Task: t))
                    : Tracker.Requests.Select(r => new Item(r.UpdatedAt, Request: r)))
                .Where(i => IsRecent(i.Active, i.UpdatedAt) == _recent)
                .Where(i => _filter.Length == 0 || i.Matches(_filter))
                .ToList();
            if (_sort != "newest")
            {
                Func<Item, string> key = _sort switch
                {
                    "artist" => i => i.Request?.Target?.ArtistName ?? "",
                    "album" => i => i.Request?.Target?.AlbumTitle ?? "",
                    _ => i => i.Request?.Target?.Name ?? i.Title,
                };
                var text = StringComparer.CurrentCultureIgnoreCase;
                return _descending ? items.OrderByDescending(key, text) : items.OrderBy(key, text);
            }
            var active = items.Where(i => i.Active)
                .OrderByDescending(i => i.Running).ThenBy(i => i.Request is not null).ThenBy(i => i.QueueOrder).ThenBy(i => i.UpdatedAt);
            var newest = active.Concat(items.Where(i => !i.Active).OrderByDescending(i => i.UpdatedAt));
            return _descending ? newest : newest.Reverse();
        }
    }

    private async Task TasksChangedAsync()
    {
        await LoadTasksAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _remembered = await Prefs.GetAsync(TabKey, "downloads");
        _recent = await Prefs.GetAsync(RecentKey, true);
        _sort = await Prefs.GetAsync(SortKey, "newest");
        _descending = await Prefs.GetAsync(DescendingKey, true);
        Tracker.Changed += Refresh;
        Events.Received += OnEvent;
        await Task.WhenAll(Tracker.RefreshAsync(), LoadTasksAsync());
        _loaded = true;
        // Tasks are polled here; requests by the tracker. Quicker while something's running.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (_tasks.Any(t => t.Active) || ++_idlePolls % 5 == 0)
            {
                await LoadTasksAsync();
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private int _idlePolls;

    // A scan or catalogue update that starts shows at once, not at the next idle poll.
    private void OnEvent(string type)
    {
        if (type is "tasks" or "connected")
            InvokeAsync(async () =>
            {
                await LoadTasksAsync();
                StateHasChanged();
            });
    }

    private async Task LoadTasksAsync()
    {
        try
        {
            _tasks = await Api.ListTasksAsync(limit: 50);
        }
        catch (HttpRequestException)
        {
            // Keep what's shown; the next poll tries again.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Tab == "listen-now")
        {
            // Listen now moved to the Library (#121).
            Nav.NavigateTo("listen-now", replace: true);
            return;
        }
        if (Tab is "tasks" or "downloads" && Tab != _remembered)
        {
            _remembered = Tab;
            await Prefs.SetAsync(TabKey, Tab);
        }
        if (OpenId is { } id && !_open.ContainsKey(id))
        {
            // A link to a request shows it under Downloads, recent or earlier as it is.
            var request = await Api.GetRequestAsync(id);
            if (Tab is null)
                _remembered = "downloads";
            // A link to a part opens its parent too, if it's one.
            var top = request?.ParentId is { } parent ? await Api.GetRequestAsync(parent) : request;
            if (top is not null)
                _recent = IsRecent(top.Active, top.UpdatedAt);
            if (request?.ParentId is { } parentId)
                _open[parentId] = top;
            _open[id] = request;
        }
    }

    private void Refresh() => InvokeAsync(async () =>
    {
        // Open requests that are still moving are reloaded with the list.
        foreach (var id in _open.Keys.ToList())
            if (Tracker.Requests.FirstOrDefault(r => r.Id == id) is not { Active: false } || _open[id]?.Children?.Any(c => c.Active) == true)
                _open[id] = await Api.GetRequestAsync(id);
        StateHasChanged();
    });

    private async Task ToggleAsync(Guid id)
    {
        if (!_open.Remove(id))
            _open[id] = await Api.GetRequestAsync(id);
    }

    private async Task ChangedAsync()
    {
        await Tracker.RefreshAsync();
        foreach (var id in _open.Keys.ToList())
            _open[id] = await Api.GetRequestAsync(id);
    }

    public void Dispose()
    {
        Tracker.Changed -= Refresh;
        Events.Received -= OnEvent;
        _timer?.Dispose();
    }
}
