@page "/tools"
@inject AuthState Auth

<PageTitle>Tools · Melodex</PageTitle>

@*
    Things you run to build your library, not settings: a card for each, in sections: lists in and out, and what writes the
    files themselves. What they're doing shows in Activity.
*@
<ToolsPlace />
<h1>Tools</h1>
<p class="muted">Things you run now and then to build your library. What each does shows in Activity as it goes.</p>

<h2>Import / Export</h2>
<div class="tool-cards">
    @if (Auth.May(UserPermissions.Request))
    {
        <a class="card tool-card" href="tools/import">
            <Icon Name="import" />
            <span>
                <strong>Import from a list</strong>
                <span class="muted small">
                    An M3U playlist, a CSV, or lines of "Artist – Title". Each song is matched to your library and the catalogue, then made a
                    playlist, and the missing songs can be asked for.
                </span>
            </span>
        </a>
        <a class="card tool-card" href="tools/import/youtube-music">
            <Icon Name="youtube-music" />
            <span>
                <strong>Import from YouTube Music</strong>
                <span class="muted small">
                    Your Google Takeout: your library songs and playlists become playlists here. Importing it again later brings only
                    what's new.
                </span>
            </span>
        </a>
        <a class="card tool-card" href="tools/import/deezer">
            <Icon Name="deezer" />
            <span>
                <strong>Import from Deezer</strong>
                <span class="muted small">
                    Your personal data's spreadsheet: your playlists and favourite tracks become playlists here, and favourite albums
                    can be asked for. Importing it again later brings only what's new.
                </span>
            </span>
        </a>
    }
    <a class="card tool-card" href="tools/export">
        <Icon Name="export" />
        <span>
            <strong>Export</strong>
            <span class="muted small">
                Your playlists as M3U8 or CSV, for other players or other services' importers, or the library as a CSV of its songs or
                albums.
            </span>
        </span>
    </a>
</div>

@if (Auth.May(UserPermissions.Format))
{
    <h2>Formatting</h2>
    <p class="muted small">These write to your music files themselves, every matched one in the library. Each asks before it starts.</p>
    <div class="tool-cards">
        <button class="card tool-card" @onclick="() => _formatting = true">
            <Icon Name="format" />
            <span>
                <strong>Format the whole library</strong>
                <span class="muted small">
                    Rewrite files' tags and covers from the catalogue, and move them to where your naming scheme says. Also on each artist,
                    album and track page.
                </span>
            </span>
        </button>
        <button class="card tool-card" @onclick="() => _levelling = true">
            <Icon Name="volume" />
            <span>
                <strong>Even volume</strong>
                <span class="muted small">
                    Work out how loud each song and album is, and write it into the files as ReplayGain, so everything plays at about the same
                    volume here, in Subsonic players and in your media server. Also on each artist and album page.
                </span>
            </span>
        </button>
    </div>
}

@if (_formatting)
{
    <FormatDialog Scope="new FormatScope(FormatScopeKind.Library, null)" Name="the whole library" OnClose="() => _formatting = false" />
}

@if (_levelling)
{
    <ReplayGainDialog Scope="new FormatScope(FormatScopeKind.Library, null)" Name="the whole library" OnClose="() => _levelling = false" />
}

@code {
    private bool _formatting, _levelling;
}
